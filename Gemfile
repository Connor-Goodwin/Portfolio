source "https://rubygems.org"

# Using a modern Jekyll directly (rather than the "github-pages" gem, which
# pins Jekyll 3.9 + an old Liquid that's incompatible with Ruby 3.2+) for
# local preview. GitHub's own Pages build runs on GitHub's servers with its
# own environment regardless of this Gemfile, so this only affects `jekyll
# serve` on your machine.
gem "jekyll", "~> 4.3"

# Ruby 3.4+ removed these from the default gems; some dependencies still need them.
gem "csv"
gem "bigdecimal"
gem "base64"
